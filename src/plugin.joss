func send($payload) {
    $fcmKey = env("FCM_SERVER_KEY", "")
    $webhookUrl = env("NOTIFY_WEBHOOK_URL", "")

    if (!empty($webhookUrl)) {
        return Http::json("POST", $webhookUrl, $payload, {
            "Content-Type": "application/json"
        })
    }

    if (!empty($fcmKey)) {
        $fcmUrl = env("FCM_URL", "https://fcm.googleapis.com/fcm/send")
        $target = (!empty($payload["user"])) ? $payload["user"] : ""
        if (empty($target) && !empty($payload["segment"])) {
            $target = "/topics/" . $payload["segment"]
        }

        $fcmPayload = {
            "to": $target,
            "notification": {
                "title": $payload["title"],
                "body": $payload["message"]
            },
            "data": $payload
        }

        return Http::json("POST", $fcmUrl, $fcmPayload, {
            "Authorization": "key=" . $fcmKey,
            "Content-Type": "application/json"
        })
    }

    print("[joss_notify] Notificación procesada para: " . $payload["user"])
    return {"ok": true, "sent": true, "data": $payload}
}

class Notify {
    Init constructor() {
        $this->app_ids = []
        $this->segment_value = ""
        $this->user_value = ""
        $this->title_value = ""
        $this->message_value = ""
        $this->html_value = ""
        $this->type_value = "push"
        $this->schedule_value = 0
    }

    func app($app) {
        $this->app_ids = [$app]
        return $this
    }

    func apps($apps) {
        $this->app_ids = $apps
        return $this
    }

    func segment($segment) {
        $this->segment_value = $segment
        return $this
    }

    func user($user) {
        $this->user_value = $user
        return $this
    }

    func title($title) {
        $this->title_value = $title
        return $this
    }

    func message($message) {
        $this->message_value = $message
        return $this
    }

    func html($html) {
        $this->html_value = $html
        return $this
    }

    func inApp() {
        $this->type_value = "in_app"
        return $this
    }

    func schedule($timestamp) {
        $this->schedule_value = $timestamp
        return $this
    }

    func send() {
        $payload = {
            "apps": $this->app_ids,
            "segment": $this->segment_value,
            "user": $this->user_value,
            "title": $this->title_value,
            "message": $this->message_value,
            "html": $this->html_value,
            "type": $this->type_value,
            "schedule": $this->schedule_value
        }

        return send($payload)
    }
}
