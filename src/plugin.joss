class Notify {
    Init constructor() {
        $this->app_ids = []
        $this->segment_value = ""
        $this->user_value = ""
        $this->title_value = ""
        $this->message_value = ""
        $this->html_value = ""
        $this->type_value = "push"
        $this->schedule_value = 0
    }

    func app($app) {
        $this->app_ids = [$app]
        return $this
    }

    func apps($apps) {
        $this->app_ids = $apps
        return $this
    }

    func segment($segment) {
        $this->segment_value = $segment
        return $this
    }

    func user($user) {
        $this->user_value = $user
        return $this
    }

    func title($title) {
        $this->title_value = $title
        return $this
    }

    func message($message) {
        $this->message_value = $message
        return $this
    }

    func html($html) {
        $this->html_value = $html
        return $this
    }

    func inApp() {
        $this->type_value = "in_app"
        return $this
    }

    func schedule($timestamp) {
        $this->schedule_value = $timestamp
        return $this
    }

    func send() {
        $payload = {
            "apps": $this->app_ids,
            "segment": $this->segment_value,
            "user": $this->user_value,
            "title": $this->title_value,
            "message": $this->message_value,
            "html": $this->html_value,
            "type": $this->type_value,
            "schedule": $this->schedule_value
        }

        // 1. Custom Webhook / Gateway
        $webhookUrl = env("NOTIFY_WEBHOOK_URL", "")
        (!empty($webhookUrl)) ? {
            print("[joss_notify] Despachando via Webhook a: " . $webhookUrl)
            return Http::json("POST", $webhookUrl, $payload, {
                "Content-Type": "application/json"
            })
        } : {}

        // 2. FCM Gateway / Endpoint
        $fcmUrl = env("FCM_URL", "")
        $fcmKey = env("FCM_SERVER_KEY", "")
        (!empty($fcmUrl) && !empty($fcmKey)) ? {
            $target = (!empty($this->user_value)) ? $this->user_value : ""
            (empty($target) && !empty($this->segment_value)) ? {
                $target = "/topics/" . $this->segment_value
            } : {}

            $fcmPayload = {
                "to": $target,
                "notification": {
                    "title": $this->title_value,
                    "body": $this->message_value
                },
                "data": $payload
            }

            print("[joss_notify] Despachando push a FCM endpoint...")
            return Http::json("POST", $fcmUrl, $fcmPayload, {
                "Authorization": "key=" . $fcmKey,
                "Content-Type": "application/json"
            })
        } : {}

        print("[joss_notify] Notificación procesada con éxito para: " . $this->user_value)
        return {"ok": true, "sent": true, "data": $payload}
    }
}

func send($payload) {
    $n = new Notify()
    (!empty($payload["apps"])) ? { $n->apps($payload["apps"]) } : {}
    (!empty($payload["user"])) ? { $n->user($payload["user"]) } : {}
    (!empty($payload["segment"])) ? { $n->segment($payload["segment"]) } : {}
    (!empty($payload["title"])) ? { $n->title($payload["title"]) } : {}
    (!empty($payload["message"])) ? { $n->message($payload["message"]) } : {}
    (!empty($payload["html"])) ? { $n->html($payload["html"]) } : {}
    (!empty($payload["type"])) ? { ($payload["type"] == "in_app") ? { $n->inApp() } : {} } : {}
    (!empty($payload["schedule"])) ? { $n->schedule($payload["schedule"]) } : {}
    return $n->send()
}
